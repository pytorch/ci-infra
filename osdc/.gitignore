# OpenTofu / Terraform
.terraform/
.terraform.d/
*.tfplan
tfplan
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# Python
.venv/
__pycache__/
*.pyc
.coverage*
coverage.json

# Generated module outputs
modules/*/generated/

# Integration test scratch (cloned canary repo)
.scratch/

# OS
.DS_Store
.env


# Packer build artifacts (AMI IDs from the last local build)
# Glob, not a literal name: a packer directory holding more than one template
# gives each its own manifest (manifest-gpu.json), and those are the same artifact.
modules/*/packer/manifest*.json
modules/*/packer/.packer.d/
