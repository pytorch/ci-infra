    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ceczcsck1b20wb"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "SELECT\n  $__timeInterval(created_at) AS time,\n  series,\n  round(quantileExact($percentile)(dateDiff('second', created_at, started_at)), 1) AS queue_seconds\nFROM (\n  SELECT created_at, started_at,\n         if('$view' = 'aggregated', 'macos (aggregated)',\n            arrayFirst(x -> x IN ('macos-m1-14','macos-m1-stable','macos-m2-15','macos-m2-26','macos-m2-stable'), labels)) AS series\n  FROM (\n    SELECT id, created_at, started_at, labels\n    FROM default.workflow_job\n    WHERE $__timeFilter(created_at)\n      AND hasAny(labels, ['macos-m1-14','macos-m1-stable','macos-m2-15','macos-m2-26','macos-m2-stable'])\n      AND ('$view' IN ('aggregated','all') OR has(labels, '$view'))\n    ORDER BY _inserted_at DESC\n    LIMIT 1 BY id\n  )\n  WHERE started_at > created_at\n)\nGROUP BY time, series\nORDER BY time, series"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Queue wait (started_at - created_at) at the selected percentile, for macOS runners, bucketed at the panel interval.",
        "id": 2,
        "links": [],
        "title": "Queue time [view, percentile]",
