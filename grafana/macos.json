    "panel-1": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ceczcsck1b20wb"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "WITH samples AS (\n  SELECT\n    time_stamp AS ts,\n    multiIf(\n      label IN ('macos-m1-14','macos-m1-stable'), 'macos-m1 (sonoma 14)',\n      label IN ('macos-m2-15','macos-m2-stable'), 'macos-m2 (sequoia 15)',\n      'macos-m2 (tahoe 26)') AS fleet,\n    max(total_count) AS runners\n  FROM misc.runner_fleet_count\n  WHERE $__timeFilter(time_stamp)\n    AND org = 'pytorch'\n    AND label IN ('macos-m1-14','macos-m1-stable','macos-m2-15','macos-m2-26','macos-m2-stable')\n    AND ('$view' IN ('aggregated','all') OR label = '$view')\n  GROUP BY ts, fleet\n),\nper_sample AS (\n  SELECT\n    ts,\n    if('$view' = 'aggregated', 'macos (aggregated)', fleet) AS series,\n    sum(runners) AS runners,\n    sum(multiIf(\n      fleet = 'macos-m1 (sonoma 14)', 111,\n      fleet = 'macos-m2 (sequoia 15)', 36,\n      8)) AS expected\n  FROM samples\n  GROUP BY ts, series\n)\nSELECT\n  $__timeInterval(ts) AS time,\n  series,\n  round(100 * max(runners) / nullIf(max(expected), 0), 1) AS pct_of_expected\nFROM per_sample\nGROUP BY time, series\nORDER BY time, series"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Registered macOS runners as a percentage of expected fleet size, from misc.runner_fleet_count (sampled every 30 min, bucketed at the panel interval). Shaded red below 50% of capacity. macos-m1-stable / macos-m2-stable are aliases on the SAME hosts as macos-m1-14 / macos-m2-15 (macos-runners/playbooks/install-runner.yml), so they are merged per fleet rather than summed. Expected counts come from pytorch-gha-infra Terraform: 111 m1/sonoma (us-east-1 6x16 + us-east-2 3x5), 36 m2/sequoia (m2pro 4x7 + m2 4x2), 8 m2/tahoe (4x2).",
        "id": 1,
        "links": [],
        "title": "Runner capacity vs expected [view]",
        "vizConfig": {
          "group": "timeseries",
          "kind": "VizConfig",
          "spec": {
