                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "SELECT day AS time, series, countIf(is_recovered) AS fail_then_success\nFROM (\n  SELECT run_id, name, series,\n    toStartOfDay(min(created_at)) AS day,\n    (countIf(conclusion = 'success') > 0)\n      AND (countIf(conclusion = 'failure') > 0)\n      AND (maxIf(run_attempt, conclusion = 'success') > minIf(run_attempt, conclusion = 'failure')) AS is_recovered\n  FROM (\n    SELECT id, run_id, name, run_attempt, conclusion, created_at,\n      if('$view' = 'aggregated', 'b200 (aggregated)',\n         arrayFirst(x -> x IN ('linux.dgx.b200','linux.dgx.b200.8'), labels)) AS series\n    FROM (\n      SELECT id, run_id, name, run_attempt, conclusion, created_at, labels\n      FROM default.workflow_job\n      WHERE $__timeFilter(created_at)\n        AND hasAny(labels, ['linux.dgx.b200','linux.dgx.b200.8'])\n        AND ('$view' IN ('aggregated','all') OR has(labels, '$view'))\n      ORDER BY _inserted_at DESC\n      LIMIT 1 BY id\n    )\n  )\n  GROUP BY run_id, name, series\n)\nGROUP BY time, series\nORDER BY time, series"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
