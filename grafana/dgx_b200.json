    "panel-2": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ceczcsck1b20wb"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "WITH jobs AS (\n  SELECT series, started_at, close_at\n  FROM (\n    SELECT\n      if('$view' = 'aggregated', 'b200 (aggregated)',\n         arrayFirst(x -> x IN ('linux.dgx.b200','linux.dgx.b200.8'), labels)) AS series,\n      run_id, name, started_at, completed_at,\n      if(completed_at > started_at, completed_at, now64(9)) AS close_at\n    FROM (\n      SELECT id, run_id, name, labels, status, started_at, completed_at\n      FROM default.workflow_job\n      WHERE $__timeFilter(created_at)\n        AND hasAny(labels, ['linux.dgx.b200','linux.dgx.b200.8'])\n        AND ('$view' IN ('aggregated','all') OR has(labels, '$view'))\n        AND notEmpty(runner_name)\n      ORDER BY _inserted_at DESC\n      LIMIT 1 BY id\n    )\n    WHERE started_at > toDateTime('2020-01-01 00:00:00')\n      AND (completed_at > started_at OR (status = 'in_progress' AND started_at > now64(9) - INTERVAL 1 DAY))\n    LIMIT 1 BY run_id, name, started_at, completed_at\n  )\n),\nevents AS (\n  SELECT series, started_at AS ts, 1 AS delta FROM jobs\n  UNION ALL\n  SELECT series, close_at AS ts, -1 AS delta FROM jobs\n),\nrunning AS (\n  SELECT series, ts,\n    sum(delta) OVER (PARTITION BY series ORDER BY ts ASC, delta ASC\n                     ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS cur\n  FROM events\n)\nSELECT toStartOfDay(ts) AS time, series, max(cur) AS max_concurrent\nFROM running\nGROUP BY time, series\nORDER BY time, series"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
