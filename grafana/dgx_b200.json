                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "ceczcsck1b20wb"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.17.0",
                      "queryType": "timeseries",
                      "rawSql": "SELECT\n  toStartOfDay(created_at) AS time,\n  series,\n  round(quantileExact($percentile)(dateDiff('second', created_at, started_at)), 1) AS queue_seconds\nFROM (\n  SELECT created_at, started_at,\n         if('$view' = 'aggregated', 'b200 (aggregated)',\n            arrayFirst(x -> x IN ('linux.dgx.b200','linux.dgx.b200.8'), labels)) AS series\n  FROM (\n    SELECT id, created_at, started_at, labels\n    FROM default.workflow_job\n    WHERE $__timeFilter(created_at)\n      AND hasAny(labels, ['linux.dgx.b200','linux.dgx.b200.8'])\n      AND ('$view' IN ('aggregated','all') OR has(labels, '$view'))\n    ORDER BY _inserted_at DESC\n    LIMIT 1 BY id\n  )\n  WHERE started_at > created_at\n)\nGROUP BY time, series\nORDER BY time, series"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Daily queue wait (started_at - created_at) at the selected percentile, for B200 runners.",
